# Alphaa Africa — environment template (tracked, no secrets).
# Copy to `.env.local` and adjust for your machine:
#   cp .env.example .env.local
# Production values live in the Vercel dashboard, not in this repo.
#
# NOTE: NEXT_PUBLIC_* keys are inlined by Next.js at build time — restart
# `pnpm dev` (and rebuild production bundles) after changing them.

# Backend API host (public URL; browsers stay same-origin via /api/* proxy).
NEXT_PUBLIC_API_BASE_URL=https://api.alphaaafrica.com
# Server-only override for the proxy and RSC/ISR reads (leave blank to reuse
# the public key above).
API_BASE_URL=

# Canonical site root for metadata, sitemaps, and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only override (leave blank to reuse the public key above).
SITE_URL=

# Analytics (optional). Blank disables GTM/GA — the provider no-ops.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
